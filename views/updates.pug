doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update Practicum Reviewers Table

        a(href='/') Return to the homepage

    form(action="/update-cobj", method="POST")
      div
        label(for="name") Name:
        input(type="text", id="name", name="name", required)
      div
        label(for="favorite_custom_object") Favorite Custom Object:
        input(type="text", id="favorite_custom_object", name="favorite_custom_object", required)
      div
        label(for="practicum_experience") Practicum Experience:
        input(type="text", id="practicum_experience", name="practicum_experience", required)
      button(type="submit") Submit